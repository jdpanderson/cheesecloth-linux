#!/usr/bin/make -f
# Runs in a cheesecloth source tree with this debian/ directory copied into
# it. See README.md.
#
# Builds with cargo and the crates from crates.io, so it needs network access
# (Cargo.lock pins every version).

export CARGO_HOME = $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR = $(CURDIR)/debian/target
# Line tables for the -dbgsym package; dh_strip strips the binary itself.
export CARGO_PROFILE_RELEASE_DEBUG = line-tables-only
export CARGO_PROFILE_RELEASE_STRIP = none

ifneq (,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
CARGO_JOBS = -j $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
endif

%:
	dh $@

override_dh_auto_clean:
	rm -rf debian/cargo-home debian/target gnome/dist

override_dh_auto_build:
	cargo build --release --locked $(CARGO_JOBS) -p cheesecloth
	tsc -p gnome/tsconfig.json

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --locked $(CARGO_JOBS) --workspace
endif

# debian/copyright names this file; keep it at that path.
override_dh_compress:
	dh_compress -X THIRD-PARTY-NOTICES.md

override_dh_auto_install:
	install -Dm755 debian/target/release/cheesecloth -t debian/cheesecloth/usr/bin
	install -Dm644 packaging/cheesecloth.service -t debian/cheesecloth/usr/lib/systemd/system
	install -Dm644 packaging/cheesecloth.default debian/cheesecloth/etc/default/cheesecloth
	install -Dm644 gnome/metadata.json gnome/dist/extension.js gnome/dist/api.js gnome/dist/display.js gnome/dist/protocol.js gnome/dist/app.js gnome/dist/widgets.js gnome/cheesecloth-symbolic.svg -t debian/gnome-shell-extension-cheesecloth/usr/share/gnome-shell/extensions/cheesecloth-gnome@janderson.ca
	install -Dm644 gnome/cheesecloth.conf debian/gnome-shell-extension-cheesecloth/usr/lib/sysusers.d/cheesecloth.conf
	install -Dm644 gnome/10-gnome.conf debian/gnome-shell-extension-cheesecloth/usr/lib/systemd/system/cheesecloth.service.d/10-gnome.conf
